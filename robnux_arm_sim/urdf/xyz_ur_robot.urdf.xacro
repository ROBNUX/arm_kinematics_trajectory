<?xml version="1.0" ?>
<!--
  XYZ_UR 5-DOF robot URDF: XYZ Gantry (3P) + UJNT (2R) tilt/pan head
  Joints: JOINT_0_ACT (P/Z), JOINT_1_ACT (P/-Y), JOINT_2_ACT (P/X),
          JOINT_3_ACT (R/Y, tilt), JOINT_4_ACT (R/X or Z, pan)

  DH parameters (XYZ part same as XYZGantry; UJNT part appended):
    XYZ: alpha=[0,PI/2,-PI/2], a=[0,0,0], theta=[0,0,0], d=[0,0,0]
    UJNT: alpha=[-PI/2,PI/2], a=[0,0], theta=[0,0], d=[0.05,0.05]
-->
<robot name="xyz_ur_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="PI"       value="3.14159265358979"/>
  <xacro:property name="RAIL_X"   value="1.2"/>
  <xacro:property name="RAIL_Y"   value="1.2"/>
  <xacro:property name="RAIL_Z"   value="0.7"/>
  <xacro:property name="RAIL_W"   value="0.04"/>
  <xacro:property name="CARRIAGE" value="0.08"/>
  <xacro:property name="GANTRY_H" value="1.0"/>
  <xacro:property name="HEAD_R"   value="0.03"/>

  <!-- world -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- gantry frame (identical to xyz_gantry) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${GANTRY_H/2}" rpy="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="5.0" ixy="0" ixz="0" iyy="5.0" iyz="0" izz="2.0"/>
    </inertial>
    <visual>
      <origin xyz="0 ${ RAIL_Y/2} ${GANTRY_H}" rpy="0 0 0"/>
      <geometry><box size="${RAIL_X} ${RAIL_W} ${RAIL_W}"/></geometry>
      <material name="rail_blue"><color rgba="0.1 0.2 0.8 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 ${-RAIL_Y/2} ${GANTRY_H}" rpy="0 0 0"/>
      <geometry><box size="${RAIL_X} ${RAIL_W} ${RAIL_W}"/></geometry>
      <material name="rail_blue"><color rgba="0.1 0.2 0.8 1"/></material>
    </visual>
    <!-- posts -->
    <visual>
      <origin xyz="${ RAIL_X/2}  ${RAIL_Y/2} ${GANTRY_H/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="${GANTRY_H}"/></geometry>
      <material name="frame_grey"><color rgba="0.45 0.45 0.45 1"/></material>
    </visual>
    <visual>
      <origin xyz="${-RAIL_X/2}  ${RAIL_Y/2} ${GANTRY_H/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="${GANTRY_H}"/></geometry>
      <material name="frame_grey"><color rgba="0.45 0.45 0.45 1"/></material>
    </visual>
    <visual>
      <origin xyz="${ RAIL_X/2} ${-RAIL_Y/2} ${GANTRY_H/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="${GANTRY_H}"/></geometry>
      <material name="frame_grey"><color rgba="0.45 0.45 0.45 1"/></material>
    </visual>
    <visual>
      <origin xyz="${-RAIL_X/2} ${-RAIL_Y/2} ${GANTRY_H/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="${GANTRY_H}"/></geometry>
      <material name="frame_grey"><color rgba="0.45 0.45 0.45 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${GANTRY_H}" rpy="0 0 0"/>
      <geometry><box size="${RAIL_X + 0.05} ${RAIL_Y + 0.05} ${RAIL_W}"/></geometry>
    </collision>
  </link>

  <!-- J0: Z stroke -->
  <joint name="JOINT_0_ACT" type="prismatic">
    <parent link="base_link"/>
    <child  link="link_z_carriage"/>
    <origin xyz="0 0 ${GANTRY_H}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-RAIL_Z * 0.8}" upper="0.0" effort="200" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_z_carriage">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="3.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${CARRIAGE} ${CARRIAGE} ${CARRIAGE}"/></geometry>
      <material name="c_silver"><color rgba="0.8 0.8 0.8 1"/></material>
    </visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${RAIL_W} ${RAIL_Y} ${RAIL_W}"/></geometry>
      <material name="rail_green"><color rgba="0.1 0.7 0.2 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${CARRIAGE} ${CARRIAGE} ${CARRIAGE}"/></geometry>
    </collision>
  </link>

  <!-- J1: -Y stroke -->
  <joint name="JOINT_1_ACT" type="prismatic">
    <parent link="link_z_carriage"/>
    <child  link="link_y_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-RAIL_Y * 0.4}" upper="${RAIL_Y * 0.4}" effort="150" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.03"/>
  </joint>

  <link name="link_y_carriage">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${CARRIAGE} ${CARRIAGE} ${CARRIAGE}"/></geometry>
      <material name="c_silver"><color rgba="0.8 0.8 0.8 1"/></material>
    </visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${RAIL_X} ${RAIL_W} ${RAIL_W}"/></geometry>
      <material name="rail_red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${CARRIAGE} ${CARRIAGE} ${CARRIAGE}"/></geometry>
    </collision>
  </link>

  <!-- J2: X stroke -->
  <joint name="JOINT_2_ACT" type="prismatic">
    <parent link="link_y_carriage"/>
    <child  link="link_x_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-RAIL_X * 0.4}" upper="${RAIL_X * 0.4}" effort="150" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.03"/>
  </joint>

  <link name="link_x_carriage">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${CARRIAGE * 0.9} ${CARRIAGE * 0.9} ${CARRIAGE * 0.9}"/></geometry>
      <material name="c_silver"><color rgba="0.8 0.8 0.8 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${CARRIAGE * 0.9} ${CARRIAGE * 0.9} ${CARRIAGE * 0.9}"/></geometry>
    </collision>
  </link>

  <!-- ======================================================= UJNT part: J3 tilt (revolute Y) -->
  <joint name="JOINT_3_ACT" type="revolute">
    <parent link="link_x_carriage"/>
    <child  link="link_ujnt_1"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="30" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="link_ujnt_1">
    <inertial><origin xyz="0 0 -0.04" rpy="0 0 0"/><mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${HEAD_R * 1.2}"/></geometry>
      <material name="head_blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <visual><origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="${HEAD_R * 0.7}" length="0.06"/></geometry>
      <material name="c_silver"><color rgba="0.8 0.8 0.8 1"/></material>
    </visual>
    <collision><origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="${HEAD_R * 0.7}" length="0.06"/></geometry>
    </collision>
  </link>

  <!-- J4: pan (revolute X) -->
  <joint name="JOINT_4_ACT" type="revolute">
    <parent link="link_ujnt_1"/>
    <child  link="link_tcp"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="20" velocity="3.14"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- TCP / tool -->
  <link name="link_tcp">
    <inertial><origin xyz="0 0 -0.025" rpy="0 0 0"/><mass value="0.1"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
    <visual><origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.04"/></geometry>
      <material name="tcp_orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <visual><origin xyz="0 0 -0.045" rpy="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="tcp_orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision><origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.04"/></geometry>
    </collision>
  </link>

</robot>
