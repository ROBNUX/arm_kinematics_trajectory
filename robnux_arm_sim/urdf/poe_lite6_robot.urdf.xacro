<?xml version="1.0" ?>
<!--
  Lite6-like compact 6-DOF serial arm URDF for POE simulation (SphericalTwoIntersecting).
  All dimensions in metres.

  POE axes at q=0 (base frame):
    J0: Z (waist)    J1: Y (shoulder, concurrent with J0)
    J2: Z (upper arm twist)  J3: Y (forearm pitch)
    J4: Z (wrist roll)  J5: Y (wrist pitch)

  T_left translations:
    J0: (0, 0, 0.300)       J1: (0, 0, 0)   ← ZERO: J0/J1 concurrent (intersecting)
    J2: (0, 0, 0.270)       J3: (0.280, 0, 0)  ← forearm extends along X
    J4: (0, 0, 0)           J5: (0, 0, 0)   ← concurrent spherical wrist

  Wrist pivot: (0.280, 0, 0.570)   Tool offset: (0, 0, 0.070)

  axes[1](Y) NOT parallel to axes[2](Z) + T_left[1] norm=0 → SphericalTwoIntersecting
-->
<robot name="poe_lite6_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="PI"       value="3.14159265358979"/>
  <xacro:property name="D_BASE"   value="0.300"/>  <!-- base to shoulder pivot height -->
  <xacro:property name="L_UPPER" value="0.270"/>  <!-- shoulder to upper-arm/forearm joint (Z) -->
  <xacro:property name="L_FORE"  value="0.280"/>  <!-- forearm length (X) -->
  <xacro:property name="D_TOOL"  value="0.070"/>  <!-- wrist to flange -->
  <xacro:property name="R"       value="0.028"/>  <!-- link tube radius -->
  <xacro:property name="R_JNT"   value="0.040"/>  <!-- joint sphere radius -->
  <xacro:property name="M"       value="1.2"/>    <!-- generic link mass -->

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base pedestal -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${D_BASE/2}" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${D_BASE/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="${D_BASE}"/></geometry>
      <material name="lite6_white"><color rgba="0.92 0.92 0.92 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
      <material name="lite6_white"><color rgba="0.92 0.92 0.92 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${D_BASE/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="${D_BASE}"/></geometry>
    </collision>
  </link>

  <!-- J0: waist — revolute Z -->
  <joint name="JOINT_0_ACT" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 ${D_BASE}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2*PI}" upper="${2*PI}" effort="50" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.15"/>
  </joint>

  <!-- link_1: shoulder hub (J1 concurrent with J0 — zero offset) -->
  <link name="link_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT}"/></geometry>
      <material name="lite6_blue"><color rgba="0.1 0.45 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT}"/></geometry>
    </collision>
  </link>

  <!-- J1: shoulder pitch — revolute Y (concurrent with J0, T_left[1]=0) -->
  <joint name="JOINT_1_ACT" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-2.61}" upper="${2.61}" effort="50" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.15"/>
  </joint>

  <!-- link_2: upper arm along Z (shoulder to forearm pivot) -->
  <link name="link_2">
    <inertial>
      <origin xyz="0 0 ${L_UPPER/2}" rpy="0 0 0"/>
      <mass value="${M}"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${L_UPPER/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${R}" length="${L_UPPER}"/></geometry>
      <material name="lite6_white"><color rgba="0.92 0.92 0.92 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT}"/></geometry>
      <material name="lite6_blue"><color rgba="0.1 0.45 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${L_UPPER/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${R}" length="${L_UPPER}"/></geometry>
    </collision>
  </link>

  <!-- J2: upper arm twist — revolute Z (NOT parallel to J1=Y → SphericalTwoIntersecting) -->
  <joint name="JOINT_2_ACT" type="revolute">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="0 0 ${L_UPPER}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2*PI}" upper="${2*PI}" effort="30" velocity="3.14"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <!-- link_3: forearm along X (to wrist pivot) -->
  <link name="link_3">
    <inertial>
      <origin xyz="${L_FORE/2} 0 0" rpy="0 ${PI/2} 0"/>
      <mass value="${M * 0.8}"/>
      <inertia ixx="0.010" ixy="0" ixz="0" iyy="0.010" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="${L_FORE/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${R*0.85}" length="${L_FORE}"/></geometry>
      <material name="lite6_white"><color rgba="0.92 0.92 0.92 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT}"/></geometry>
      <material name="lite6_blue"><color rgba="0.1 0.45 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="${L_FORE/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${R*0.85}" length="${L_FORE}"/></geometry>
    </collision>
  </link>

  <!-- J3: forearm pitch — revolute Y (at wrist pivot end of forearm) -->
  <joint name="JOINT_3_ACT" type="revolute">
    <parent link="link_3"/>
    <child  link="link_4"/>
    <origin xyz="${L_FORE} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-2.61}" upper="${2.61}" effort="30" velocity="3.14"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <!-- link_4: wrist hub 1 (J3/J4 concurrent) -->
  <link name="link_4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT}"/></geometry>
      <material name="lite6_blue"><color rgba="0.1 0.45 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT}"/></geometry>
    </collision>
  </link>

  <!-- J4: wrist roll — revolute Z (concurrent with J3) -->
  <joint name="JOINT_4_ACT" type="revolute">
    <parent link="link_4"/>
    <child  link="link_5"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2*PI}" upper="${2*PI}" effort="20" velocity="3.14"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- link_5: wrist hub 2 (J4/J5 concurrent) -->
  <link name="link_5">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT*0.8}"/></geometry>
      <material name="lite6_grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R_JNT*0.8}"/></geometry>
    </collision>
  </link>

  <!-- J5: wrist pitch — revolute Y (concurrent with J3, J4 → spherical wrist) -->
  <joint name="JOINT_5_ACT" type="revolute">
    <parent link="link_5"/>
    <child  link="link_6"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-2.61}" upper="${2.61}" effort="20" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.03"/>
  </joint>

  <!-- link_6: flange + TCP marker -->
  <link name="link_6">
    <inertial>
      <origin xyz="0 0 ${D_TOOL/2}" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${D_TOOL/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="${D_TOOL}"/></geometry>
      <material name="lite6_dark"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 ${D_TOOL}" rpy="0 0 0"/>
      <geometry><sphere radius="0.010"/></geometry>
      <material name="lite6_tcp"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${D_TOOL/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="${D_TOOL}"/></geometry>
    </collision>
  </link>

</robot>
