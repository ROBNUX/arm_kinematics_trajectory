<?xml version="1.0" ?>
<!--
  6020 SCARA 4-DOF robot URDF — parameters loaded from
  robot_model/6020_scara.txt (Craig DH convention), read as
  [alpha x4 | a x4 | theta x4 | d x4] (+ optional trailing tool-length
  scalar folded into d[3]; this file's trailing values are all 0).

  DH parameters (see scripts/simulate_6020_scara.py for the loader):
    alpha = [0, 0, 0, 0]
    a     = [0, 0.325, 0.275, 0]   upper arm 325 mm, forearm 275 mm (600 mm reach)
    theta = [0, 0, 0, 0]
    d     = [0, 0, 0, 0]           no base height / tool offset in this data file

  Joint origins are each DH_Craig1989(a[i],alpha[i],d[i],theta[i]) evaluated
  at q=0, i.e. exactly the fixed part of the transform serialArm::JntToCart
  composes at runtime  — computed numerically (not hand-derived) so the
  visual model matches scara.cpp's FK bit-for-bit:
    JOINT_0_ACT: xyz=(0,0,0)         rpy=(0,0,0)
    JOINT_1_ACT: xyz=(0.325,0,0)     rpy=(0,0,0)
    JOINT_2_ACT: xyz=(0.275,0,0)     rpy=(0,0,0)   (prismatic Z, stroke is the joint variable)
    JOINT_3_ACT: xyz=(0,0,0)         rpy=(0,0,0)

  Since d=[0,0,0,0], the shoulder joint sits at world origin (z=0) and there
  is no baked-in tool offset  — this is a faithful rendering of the provided
  robot_model file, not an idealized/prettied-up SCARA.
-->
<robot name="scara_6020_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="PI"  value="3.14159265358979"/>
  <xacro:property name="A1"  value="0.325"/>  <!-- upper arm length -->
  <xacro:property name="A2"  value="0.275"/>  <!-- forearm length -->
  <xacro:property name="ARM_RADIUS" value="0.020"/>
  <xacro:property name="BASE_SIDE"  value="0.16"/>
  <xacro:property name="BASE_H"     value="0.04"/>
  <xacro:property name="ARM_MASS"   value="1.2"/>
  <xacro:property name="BASE_MASS"  value="6.0"/>

  <!-- ============================================================ world -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ base -->
  <!-- Thin mounting plate only  — the DH data has d[0]=0 (shoulder axis
       sits at world Z=0), so no pedestal height is added here; adding one
       would make the visual model disagree with what scara.cpp actually
       computes for FK. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${-BASE_H/2}" rpy="0 0 0"/>
      <mass value="${BASE_MASS}"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${-BASE_H/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${BASE_SIDE} ${BASE_SIDE} ${BASE_H}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${-BASE_H/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${BASE_SIDE} ${BASE_SIDE} ${BASE_H}"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ J0: shoulder rotation (revolute Z) -->
  <joint name="JOINT_0_ACT" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="60" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- shoulder hub + upper arm -->
  <link name="link_1">
    <inertial>
      <origin xyz="${A1/2} 0 0" rpy="0 ${PI/2} 0"/>
      <mass value="${ARM_MASS}"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.028" length="0.05"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <visual>
      <origin xyz="${A1/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${ARM_RADIUS}" length="${A1}"/></geometry>
      <material name="silver"><color rgba="0.8 0.8 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="${A1/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${ARM_RADIUS}" length="${A1}"/></geometry>
    </collision>
  </link>

  <!-- ============================================================ J1: elbow rotation (revolute Z) -->
  <joint name="JOINT_1_ACT" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="${A1} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="35" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- elbow hub + forearm -->
  <link name="link_2">
    <inertial>
      <origin xyz="${A2/2} 0 0" rpy="0 ${PI/2} 0"/>
      <mass value="${ARM_MASS * 0.6}"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.024" length="0.04"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <visual>
      <origin xyz="${A2/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${ARM_RADIUS * 0.85}" length="${A2}"/></geometry>
      <material name="silver"><color rgba="0.8 0.8 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="${A2/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${ARM_RADIUS * 0.85}" length="${A2}"/></geometry>
    </collision>
  </link>

  <!-- ============================================================ J2: Z stroke (prismatic Z) -->
  <joint name="JOINT_2_ACT" type="prismatic">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="${A2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.15" upper="0.05" effort="100" velocity="0.5"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- spindle / Z-stroke tube -->
  <link name="link_3">
    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.12"/></geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.12"/></geometry>
    </collision>
  </link>

  <!-- ============================================================ J3: wrist rotation (revolute Z) -->
  <joint name="JOINT_3_ACT" type="revolute">
    <parent link="link_3"/>
    <child  link="link_4"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2*PI}" upper="${2*PI}" effort="10" velocity="6.28"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- tool / end-effector -->
  <link name="link_4">
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.01" length="0.04"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.01" length="0.04"/></geometry>
    </collision>
  </link>

</robot>
