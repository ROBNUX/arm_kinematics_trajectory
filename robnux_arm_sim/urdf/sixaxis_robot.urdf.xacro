<?xml version="1.0" ?>
<!--
  SixAxis_1 6-DOF serial arm URDF (Mitsubishi articulated convention)
  Joints: JOINT_0_ACT through JOINT_5_ACT, all revolute.

  DH parameters used in simulation scripts (Craig convention):
    alpha = [0,   -PI/2,  0,   -PI/2,  PI/2,  -PI/2]
    a     = [0,    0.075, 0.25,  0.03,  0,      0   ]
    theta = [0,    PI/2,  0,     0,     0,      0   ]    (home offsets)
    d     = [0.33, 0,     0,     0.25,  0,      0.09]

  URDF joint origins (simplified, approximate from DH):
    JOINT_0_ACT: xyz=(0,0,0)   Z-axis  (waist)
    JOINT_1_ACT: xyz=(0,0,D0)  Y-axis  (shoulder pitch)
    JOINT_2_ACT: xyz=(0,A2,0)  Y-axis  (elbow)   [arm along Y after J1 +90 offset]
    JOINT_3_ACT: xyz=(0,A3,0)  X-axis  (forearm roll)
    JOINT_4_ACT: xyz=(0,0,-D3) Y-axis  (wrist pitch)
    JOINT_5_ACT: xyz=(0,0,-D5) Z-axis  (wrist roll)
-->
<robot name="sixaxis_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="PI"    value="3.14159265358979"/>
  <xacro:property name="D0"   value="0.33"/>   <!-- base to shoulder height -->
  <xacro:property name="A1"   value="0.075"/>  <!-- shoulder horizontal offset -->
  <xacro:property name="A2"   value="0.25"/>   <!-- upper arm -->
  <xacro:property name="A3"   value="0.03"/>   <!-- elbow geometry offset -->
  <xacro:property name="D3"   value="0.25"/>   <!-- forearm length -->
  <xacro:property name="D5"   value="0.09"/>   <!-- tool length -->
  <xacro:property name="LINK_R"  value="0.035"/>
  <xacro:property name="LINK_MASS" value="2.0"/>

  <!-- world -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.13"/></geometry>
      <material name="base_grey"><color rgba="0.4 0.4 0.4 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.13"/></geometry>
    </collision>
  </link>

  <!-- ======================================================= J0: waist (revolute Z) -->
  <joint name="JOINT_0_ACT" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="200" velocity="2.09"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- trunk / column -->
  <link name="link_1">
    <inertial>
      <origin xyz="0 0 ${D0/2}" rpy="0 0 0"/>
      <mass value="${LINK_MASS * 1.5}"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${D0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${LINK_R}" length="${D0}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${D0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${LINK_R}" length="${D0}"/></geometry>
    </collision>
  </link>

  <!-- ======================================================= J1: shoulder pitch (revolute Y) -->
  <joint name="JOINT_1_ACT" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="${A1} 0 ${D0}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI}" effort="150" velocity="2.09"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- upper arm -->
  <link name="link_2">
    <inertial>
      <origin xyz="${A2/2} 0 0" rpy="0 ${PI/2} 0"/>
      <mass value="${LINK_MASS}"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="${A2/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${LINK_R}" length="${A2}"/></geometry>
      <material name="silver"><color rgba="0.8 0.8 0.85 1"/></material>
    </visual>
    <!-- shoulder hub -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${LINK_R * 1.2}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="${A2/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${LINK_R}" length="${A2}"/></geometry>
    </collision>
  </link>

  <!-- ======================================================= J2: elbow pitch (revolute Y) -->
  <joint name="JOINT_2_ACT" type="revolute">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="${A2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI}" upper="${PI/2}" effort="100" velocity="2.61"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <!-- forearm -->
  <link name="link_3">
    <inertial>
      <origin xyz="${D3/2} 0 0" rpy="0 ${PI/2} 0"/>
      <mass value="${LINK_MASS * 0.8}"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.004"/>
    </inertial>
    <!-- elbow hub -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${LINK_R * 1.1}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <!-- forearm tube -->
    <visual>
      <origin xyz="${D3/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${LINK_R * 0.85}" length="${D3}"/></geometry>
      <material name="silver"><color rgba="0.8 0.8 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="${D3/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${LINK_R * 0.85}" length="${D3}"/></geometry>
    </collision>
  </link>

  <!-- ======================================================= J3: forearm roll (revolute X) -->
  <joint name="JOINT_3_ACT" type="revolute">
    <parent link="link_3"/>
    <child  link="link_4"/>
    <origin xyz="${D3} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="60" velocity="3.14"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="link_4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${LINK_R}"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${LINK_R}"/></geometry>
    </collision>
  </link>

  <!-- ======================================================= J4: wrist pitch (revolute Y) -->
  <joint name="JOINT_4_ACT" type="revolute">
    <parent link="link_4"/>
    <child  link="link_5"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI * 0.75}" upper="${PI * 0.75}" effort="30" velocity="3.66"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="link_5">
    <inertial>
      <origin xyz="0 0 ${-D5 * 0.4}" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${LINK_R * 0.8}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${LINK_R * 0.8}"/></geometry>
    </collision>
  </link>

  <!-- ======================================================= J5: wrist roll (revolute X) -->
  <joint name="JOINT_5_ACT" type="revolute">
    <parent link="link_5"/>
    <child  link="link_6"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="20" velocity="5.23"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- tool / end-effector -->
  <link name="link_6">
    <inertial>
      <origin xyz="0 0 ${-D5/2}" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0002"/>
    </inertial>
    <!-- wrist cylinder -->
    <visual>
      <origin xyz="0 0 ${-D5/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="${D5}"/></geometry>
      <material name="dark"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <!-- TCP marker -->
    <visual>
      <origin xyz="0 0 ${-D5}" rpy="0 0 0"/>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${-D5/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="${D5}"/></geometry>
    </collision>
  </link>

</robot>
