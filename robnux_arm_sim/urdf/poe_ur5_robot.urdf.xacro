<?xml version="1.0" ?>
<!--
  UR5-like 6-DOF serial arm URDF for POE simulation (ThreeParallel topology).
  Joint origins match POE T_left translations; all dimensions in metres.

  POE axes at q=0 (base frame):
    J0: Z (waist)    J1: Y (shoulder)  J2: Y (elbow)
    J3: Y (wrist1)   J4: Z (wrist2)    J5: Y (wrist3)

  T_left translations:
    J0: (0, 0, 0.0892)      J1: (0, 0.1358, 0)     J2: (0.425, 0, 0)
    J3: (0.3922, 0, 0)      J4: (0, 0.1091, 0)      J5: (0, 0, 0.0946)
  TCP tool offset: (0, 0, 0.0823) on J5 T_right.
-->
<robot name="poe_ur5_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="PI"    value="3.14159265358979"/>
  <xacro:property name="D0"   value="0.0892"/>  <!-- base to J0 height -->
  <xacro:property name="L01Y" value="0.1358"/>  <!-- J0→J1 lateral (Y) -->
  <xacro:property name="L12X" value="0.4250"/>  <!-- J1→J2 upper arm (X) -->
  <xacro:property name="L23X" value="0.3922"/>  <!-- J2→J3 forearm (X) -->
  <xacro:property name="L34Y" value="0.1091"/>  <!-- J3→J4 wrist-1 lateral (Y) -->
  <xacro:property name="L45Z" value="0.0946"/>  <!-- J4→J5 wrist-2 height (Z) -->
  <xacro:property name="TOOL" value="0.0823"/>  <!-- J5→TCP flange (Z) -->
  <xacro:property name="R"    value="0.030"/>   <!-- link tube radius -->
  <xacro:property name="M"    value="1.5"/>     <!-- generic link mass -->

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${D0/2}" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${D0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="${D0}"/></geometry>
      <material name="base_grey"><color rgba="0.35 0.35 0.35 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${D0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="${D0}"/></geometry>
    </collision>
  </link>

  <!-- J0: waist — revolute Z, child frame shifts +Y by L01Y to reach shoulder -->
  <joint name="JOINT_0_ACT" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 ${D0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2*PI}" upper="${2*PI}" effort="330" velocity="2.09"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- link_1: waist→shoulder stub along Y -->
  <link name="link_1">
    <inertial>
      <origin xyz="0 ${L01Y/2} 0" rpy="${PI/2} 0 0"/>
      <mass value="${M}"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 ${L01Y/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${R}" length="${L01Y}"/></geometry>
      <material name="ur_silver"><color rgba="0.82 0.82 0.82 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R*1.3}"/></geometry>
      <material name="ur_dark"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 ${L01Y/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${R}" length="${L01Y}"/></geometry>
    </collision>
  </link>

  <!-- J1: shoulder pitch — revolute Y, moves along +X by L12X -->
  <joint name="JOINT_1_ACT" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="0 ${L01Y} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="330" velocity="2.09"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- link_2: upper arm along X -->
  <link name="link_2">
    <inertial>
      <origin xyz="${L12X/2} 0 0" rpy="0 ${PI/2} 0"/>
      <mass value="${M * 1.2}"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="${L12X/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${R}" length="${L12X}"/></geometry>
      <material name="ur_silver"><color rgba="0.82 0.82 0.82 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R*1.3}"/></geometry>
      <material name="ur_blue"><color rgba="0.1 0.35 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="${L12X/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${R}" length="${L12X}"/></geometry>
    </collision>
  </link>

  <!-- J2: elbow pitch — revolute Y, forearm along +X -->
  <joint name="JOINT_2_ACT" type="revolute">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="${L12X} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="150" velocity="3.14"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <!-- link_3: forearm along X -->
  <link name="link_3">
    <inertial>
      <origin xyz="${L23X/2} 0 0" rpy="0 ${PI/2} 0"/>
      <mass value="${M}"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="${L23X/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${R*0.85}" length="${L23X}"/></geometry>
      <material name="ur_silver"><color rgba="0.82 0.82 0.82 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R*1.2}"/></geometry>
      <material name="ur_blue"><color rgba="0.1 0.35 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="${L23X/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="${R*0.85}" length="${L23X}"/></geometry>
    </collision>
  </link>

  <!-- J3: wrist-1 pitch — revolute Y, lateral shift +Y -->
  <joint name="JOINT_3_ACT" type="revolute">
    <parent link="link_3"/>
    <child  link="link_4"/>
    <origin xyz="${L23X} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="54" velocity="3.14"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- link_4: wrist-1 lateral stub along Y -->
  <link name="link_4">
    <inertial>
      <origin xyz="0 ${L34Y/2} 0" rpy="${PI/2} 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 ${L34Y/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${R*0.7}" length="${L34Y}"/></geometry>
      <material name="ur_dark"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R*1.1}"/></geometry>
      <material name="ur_blue"><color rgba="0.1 0.35 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 ${L34Y/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${R*0.7}" length="${L34Y}"/></geometry>
    </collision>
  </link>

  <!-- J4: wrist-2 roll — axis -Z, lifts along +Z -->
  <joint name="JOINT_4_ACT" type="revolute">
    <parent link="link_4"/>
    <child  link="link_5"/>
    <origin xyz="0 ${L34Y} 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="${-PI}" upper="${PI}" effort="54" velocity="3.66"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- link_5: wrist-2 height stub along Z -->
  <link name="link_5">
    <inertial>
      <origin xyz="0 0 ${L45Z/2}" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${L45Z/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${R*0.7}" length="${L45Z}"/></geometry>
      <material name="ur_dark"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${R}"/></geometry>
      <material name="ur_blue"><color rgba="0.1 0.35 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${L45Z/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${R*0.7}" length="${L45Z}"/></geometry>
    </collision>
  </link>

  <!-- J5: wrist-3 pitch — revolute Y, tool along +Z -->
  <joint name="JOINT_5_ACT" type="revolute">
    <parent link="link_5"/>
    <child  link="link_6"/>
    <origin xyz="0 0 ${L45Z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="54" velocity="3.66"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- link_6: tool flange + TCP marker -->
  <link name="link_6">
    <inertial>
      <origin xyz="0 0 ${TOOL/2}" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${TOOL/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="${TOOL}"/></geometry>
      <material name="ur_dark"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 ${TOOL}" rpy="0 0 0"/>
      <geometry><sphere radius="0.010"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${TOOL/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="${TOOL}"/></geometry>
    </collision>
  </link>

</robot>
